    <h2 class="section-header" id="$(no_spaces(kind))-details"><a name="$(no_spaces(kind))"></a>$(class and '<a name="' .. class .. '"></a>' or '')$(kind) in detail</h2>
    $(M(module.kinds:get_section_description(kind),nil))
