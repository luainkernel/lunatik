            <pre class="example">$(ldoc.prettify(kitem.usage[1]))</pre>
#        end
#   end
    <dl class="function">
#  for item in items() do
    <dt id="$(item.name)"><a name="$(item.name)"></a><strong>$(display_name(item))</strong></dt>
    <dd>
    $(M(ldoc.descript(item),item))

