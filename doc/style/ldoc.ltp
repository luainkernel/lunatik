<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="$(ldoc.doc_charset)"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>$(title and (title .. ' · ') or '')$(ldoc.project)</title>
    <meta name="description" content="$(ldoc.description)"/>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 98 100'%3E%3Ccircle cx='36.2' cy='63.8' r='34.7' fill='none' stroke='%238a91a3' stroke-width='3' stroke-dasharray='6 4'/%3E%3Cpath fill='%2313139a' fill-rule='evenodd' d='$(LOGO)'/%3E%3Ccircle fill='%2313139a' cx='36.2' cy='61.5' r='8.9'/%3E%3C/svg%3E"/>
    <link rel="stylesheet" href="$(ldoc.css)" type="text/css" />
    <script>try { var t = localStorage.getItem('lunatik-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }</script>
    <script src="$(up)search.js" defer=""></script>
    <script src="$(up)site.js" defer=""></script>
</head>
<body data-root="$(up)">

<header class="topbar">
    <button class="icon-btn nav-toggle" id="nav" type="button" aria-label="Menu" aria-expanded="false" aria-controls="sidebar">
        <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="$(up)index.html">
        <svg viewBox="0 0 98 100" aria-hidden="true"><circle class="logo-orbit" cx="36.2" cy="63.8" r="34.7"/><path class="logo-mark" fill-rule="evenodd" d="$(LOGO)"/><circle class="logo-mark" cx="36.2" cy="61.5" r="8.9"/></svg>
        <span>$(ldoc.project)</span>
    </a>
    <a class="release" href="$(GITHUB)/releases" title="The release these pages document">$(VERSION)</a>
    <div class="search" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke-width="2"/></svg>
        <input id="q" type="search" placeholder="Search modules, functions, the guide" autocomplete="off" aria-label="Search" aria-controls="results"/>
        <kbd>/</kbd>
        <ul class="results" id="results" hidden=""></ul>
    </div>
    <nav class="top-links" aria-label="Site">
# if guide[1] then
        <a href="$(up)topics/$(guide[1].name).html">Guide</a>
# end
        <a href="$(up)index.html#api-reference">API</a>
        <a class="star" href="$(GITHUB)" title="Star Lunatik on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>Star on GitHub</a>
        <a class="donate" href="$(DONATE)" title="Donate through PayPal and write Lunatik in the note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>Donate</a>
        <button class="icon-btn" id="theme" type="button" aria-label="Switch between light and dark">
            <svg class="theme-icon-light" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="theme-icon-dark" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        </button>
    </nav>
</header>

# if not module then
<section class="hero">
<div class="hero-inner">
<div class="hero-text">
    <h1>Script the Linux kernel <span class="moon-word">with Lua</span></h1>
    <p class="hero-lead">$(intro or ldoc.description)</p>
    <div class="hero-actions">
# if guide[1] then
        <a class="btn primary" href="topics/$(guide[1].name).html">Get started</a>
# end
        <a class="btn" href="#api-reference">API reference</a>
        <a class="btn" href="$(GITHUB)">GitHub</a>
    </div>
    <ul class="facts">
        <li><strong>$(nmodules)</strong> Lua modules</li>
# if floor then
        <li>Linux <strong>$(floor)</strong> and later</li>
# end
        <li>Process, softirq and hardirq hooks</li>
    </ul>
</div>
<figure class="window">
    <figcaption><span>$(SHOWCASE)</span><a href="$(GITHUB)/tree/master/$(dirname(SHOWCASE))">About this example</a></figcaption>
    <pre class="example">$(showcase)</pre>
</figure>
</div>
</section>
# end

<div class="layout">

<aside class="sidebar" id="sidebar" aria-label="Documentation">
# if #guide > 0 then
<h2>Guide</h2>
<ul>
#  for _, m in ldoc.ipairs(guide) do
  <li><a href="$(ldoc.ref_to_module(m))"$(module and m.name == module.name and ' aria-current="page"' or '')>$(display_name(m))</a></li>
#  end
</ul>
# end
<h2>Lua API</h2>
# for i, area in ldoc.ipairs(AREAS) do
#  if members[i] then
<h3>$(area[2])</h3>
<ul class="mono">
#   for _, m in ldoc.ipairs(members[i]) do
  <li><a href="$(ldoc.ref_to_module(m))"$(module and m.name == module.name and ' aria-current="page"' or '')>$(m.name)</a></li>
#   end
</ul>
#  end
# end
</aside>

<main class="content" id="content">

# if istopic then -- a page of the guide
#   local position
#   for i, m in ldoc.ipairs(guide) do if m.name == module.name then position = i end end
    $(anchor(relink(ldoc.body, module.file.filename, '../')))
#   if position then
<nav class="pager" aria-label="Guide pages">
#     if guide[position - 1] then local prev = guide[position - 1]
    <a class="prev" href="$(ldoc.ref_to_module(prev))"><span>Previous</span>$(display_name(prev))</a>
#     end
#     if guide[position + 1] then local next = guide[position + 1]
    <a class="next" href="$(ldoc.ref_to_module(next))"><span>Next</span>$(display_name(next))</a>
#     end
</nav>
#   end
#   if root then
<a class="edit" href="$(GITHUB)/edit/master/$(module.file.filename:sub(#root + 2))">Edit this page on GitHub</a>
#   end
# elseif module then -- module documentation
<div class="crumbs"><a href="../index.html#api-reference">Lua API</a> · <a href="../index.html#api-$(AREAS[current][1])">$(AREAS[current][2])</a></div>
<h1>$(module.name)<span class="kind">$(ldoc.module_typename(module))</span></h1>
<p class="lead">$(M(module.summary,module))</p>
$(M(module.description,module))
#   if module.tags.include then
        $(M(ldoc.include_file(module.tags.include)))
#   end
#   if module.see then
#     local li,il = use_li(module.see)
    <h3>See also</h3>
    <ul>
#     for see in iter(module.see) do
         $(li)<a href="$(ldoc.href(see))">$(see.label)</a>$(il)
#    end -- for
    </ul>
#   end -- if see
#   if module.usage then
    <h2 id="usage">Usage</h2>
#     for usage in iter(module.usage) do
        <pre class="example">$(ldoc.escape(usage))</pre>
#     end -- for
#   end -- if usage
#   if module.info then
    <ul>
#     for tag, value in module.info:iter() do
        <li><strong>$(tag)</strong>: $(M(value,module))</li>
