local config = require("lunatik.config")

local device    = "/dev/lunatik"
local copyright = "Copyright (C) 2023-2026 Ring Zero Desenvolvimento de Software LTDA."
local modules   = config.modules

local function probe()
	return os.execute("[ -e " .. device .. " ]")
end

local function dostring(chunk)
	local session <close> = assert(io.open(device, "r+"))
	session:setvbuf("no") -- the driver runs each write as a chunk
	assert(session:write(chunk))
	session:flush()
	local reply = assert(session:read("a"))
	local status, result = reply:match("^(%a+)\t(.*)$")
	if status == nil then -- a driver loaded from a build that replies without the status
		return true, reply
	end
	return status == "true", result
end

local function sh(command, module, loaded)
	local op = loaded and "&&" or "||"
	return os.execute(string.format("MODULE=%s;grep -wq $MODULE /proc/modules %s%s", module, op, command))
end

local function load_modules()
	for _, m in ipairs(modules) do
		sh("modprobe $MODULE", m)
	end
	if not probe() then
		error("couldn't create " .. device, 0)
	end
	local ok, result = dostring[[
		lunatik = require("lunatik")
		lunatik.runner = require("lunatik.runner")
		lunatik.runner.startup()
	]]
	if not ok then error(result, 0) end
end

local function readall(handle)
	local h <close> = handle
	return h and h:read("a") or ""
end

local function holders()
	return readall(io.popen("ls /sys/module/lunatik/holders 2>/dev/null"))
end

local function refcount(module)
	return tonumber(readall(io.open("/sys/module/" .. module .. "/refcnt")))
end

local function stale_modules()
	local stale = {}
	for m in (holders() .. " lunatik"):gmatch("%S+") do
		local loaded = readall(io.open("/sys/module/" .. m .. "/srcversion"))
		local installed = readall(io.popen("modinfo -F srcversion " .. m .. " 2>/dev/null"))
		if loaded ~= installed then
			table.insert(stale, m)
		end
	end
	return stale
end

local function unload_unused()
	local removed = 0
	for m in (holders() .. " lunatik"):gmatch("%S+") do
		if refcount(m) == 0 and sh("rmmod $MODULE", m, true) then
			removed = removed + 1
		end
	end
	return removed
end

local function unload_modules()
	if probe() then
		local ok, result = dostring("lunatik.runner.shutdown()")
		if not ok then error(result, 0) end
	end
	repeat
		local removed = unload_unused()
	until removed == 0
end

local function reload_modules()
	unload_modules()
	load_modules()
	local stale = stale_modules()
	if #stale > 0 then
		error("couldn't replace " .. table.concat(stale, ", ") .. ": loaded from another build", 0)
	end
end

local function status_modules()
	for _, m in ipairs(modules) do
		sh("echo $MODULE is loaded || echo $MODULE is not loaded", m, true)
	end
	for _, m in ipairs(stale_modules()) do
		print(m .. " is not the installed build")
	end
end

local function ensure_loaded()
	if not probe() then load_modules() end
	local ok, result = dostring[[
		lunatik = lunatik or require("lunatik")
		lunatik.runner = lunatik.runner or require("lunatik.runner")
		lunatik.runner.startup()
	]]
	if not ok then error(result, 0) end
end

local tests_path = "/usr/local/share/lunatik/tests"

local function test_modules(suite)
	local target = suite and (tests_path .. "/" .. suite .. "/run.sh")
	                      or (tests_path .. "/run.sh")
	if not os.execute("[ -f " .. target .. " ]") then
		error("tests not installed; run: sudo make tests_install", 0)
	end
	reload_modules()
	ensure_loaded()
	local ok, _, code = os.execute("bash " .. target)
	unload_modules()
	return ok or code
end

local function compile_scripts(...)
	local args = {}
	for _, word in ipairs({...}) do
		table.insert(args, "'" .. word:gsub("'", "'\\''") .. "'")
	end
	local ok, _, code = os.execute("lunatic " .. table.concat(args, " "))
	os.exit(ok or code)
end

local commands = {
	load   = load_modules,
	unload = unload_modules,
	reload = reload_modules,
	status = status_modules,
	test   = test_modules,
	compile = compile_scripts,
}

local function readline_reader()
	local rl = require("readline")
	rl.set_readline_name("lunatik")
	local function read_line(prompt)
		local line = rl.readline(prompt)
		if line and line ~= "" then rl.add_history(line) end
		return line
	end
	return read_line
end

local function fallback_reader(prompt)
	io.write(prompt)
	io.flush()
	return io.read("l")
end

local function piped_reader()
	return io.read("l")
end

local function isterminal()
	return os.execute("[ -t 0 ]")
end

local usage = [=[
usage: lunatik [-h | -V]
       lunatik [-i] [-e <chunk>]
       lunatik load | unload | reload | status
       lunatik run [-c process | softirq | hardirq] [-p] <script>
       lunatik spawn <script>
       lunatik stop <script>...
       lunatik list
       lunatik test [<suite>]
       lunatik compile [<lunatic argument>...]]=]

local function report(message)
	io.stderr:write("lunatik: ", message, "\n")
end

local function fail(message)
	report(message)
	os.exit(false)
end

local function misuse(message)
	io.stderr:write("lunatik: ", message, "\n", usage, "\n")
	os.exit(2)
end

local function try_as_expr(chunk)
	return load("return " .. chunk .. ";") ~= nil
end

local function is_incomplete(chunk)
	local _, err = load(chunk)
	return err ~= nil and err:sub(-5) == "<eof>"
end

local function repl(read_line)
	local line = read_line("> ")
	while line ~= nil do
		local chunk = line
		local expr = try_as_expr(chunk) -- a name or a field also reads as an unfinished assignment
		while not expr and is_incomplete(chunk) do
			local more = read_line(">> ")
			if more == nil then break end
			chunk = chunk .. "\n" .. more
			expr = try_as_expr(chunk)
		end
		local ok, res = dostring(expr and ("return " .. chunk) or chunk)
		if not ok then
			io.stderr:write(res, "\n")
		elseif res ~= "" then
			print(res)
		end
		line = read_line("> ")
	end
end

local function version()
	local _, result = dostring("return _LUNATIK_VERSION")
	return result
end

local function start_repl()
	ensure_loaded()
	if not isterminal() then
		return repl(piped_reader)
	end
	print(version() .. "  " .. copyright)
	local ok, read_line = pcall(readline_reader)
	if not ok then read_line = fallback_reader end
	repl(read_line)
end

local function request(chunk, ...)
	local ok, result = dostring(string.format(chunk, ...))
	if not ok then fail(result) end
	return result
end

local function eval(chunk)
	ensure_loaded()
	local result = request("%s", chunk)
	if result ~= "" then print(result) end
end

local contexts = {process = true, softirq = true, hardirq = true}

local options = {}

function options.help()
	print(usage)
	os.exit()
end

function options.version()
	if not probe() then fail("not loaded") end
	print(version())
	os.exit()
end

function options.interactive(parsed)
	parsed.interactive = true
end

function options.eval(parsed, chunk)
	parsed.chunk = chunk
end

function options.context(parsed, word)
	if not contexts[word] then
		misuse(word .. " is not a context: process, softirq or hardirq")
	end
	parsed.context = word
end

function options.percpu(parsed)
	parsed.percpu = true
end

local spellings = {
	["-h"] = "help", ["--help"] = "help",
	["-V"] = "version", ["--version"] = "version",
	["-i"] = "interactive", ["--interactive"] = "interactive",
	["-e"] = "eval", ["--eval"] = "eval",
	["-c"] = "context", ["--context"] = "context",
	["-p"] = "percpu", ["--percpu"] = "percpu",
}

local valued = {eval = true, context = true}
local general = {help = true, version = true, interactive = true, eval = true}
local modifying = {context = true, percpu = true, ["--"] = true}

local function parse(i, accepted, parsed)
	while arg[i] ~= nil and arg[i]:sub(1, 1) == "-" do
		if arg[i] == "--" and accepted["--"] then
			return i + 1
		end
		local spelling, value = arg[i]:match("^(%-%-[^=]+)=(.*)$")
		spelling = spelling or arg[i]
		local name = spellings[spelling]
		if name == nil or not accepted[name] then
			misuse("unknown option " .. spelling)
		elseif valued[name] and value == nil then
			i = i + 1
			value = arg[i] or misuse(spelling .. " takes a value")
		elseif not valued[name] and value ~= nil then
			misuse(spelling .. " takes no value")
		end
		options[name](parsed, value)
		i = i + 1
	end
	return i
end

-- the words after the script that options replace, still read for one release
local function modifiers(parsed, ...)
	for _, word in ipairs({...}) do
		local name = word == "percpu" and "percpu" or "context"
		local option = name == "percpu" and "-p" or "-c " .. word
		options[name](parsed, word)
		report(string.format("%s after the script is deprecated, use %s", word, option))
	end
end

local function unmodified(verb, parsed, ...)
	if parsed.context or parsed.percpu or select("#", ...) > 0 then
		misuse(verb .. " takes no context and no percpu")
	end
end

local runners = {}

function runners.run(parsed, script, ...)
	if script == nil then misuse("run takes a script") end
	modifiers(parsed, ...)
	ensure_loaded()
	request("lunatik.runner.run(%q, %q, %q)", script, parsed.context, parsed.percpu)
end

function runners.spawn(parsed, script, ...)
	if script == nil then misuse("spawn takes a script") end
	unmodified("spawn", parsed, ...)
	ensure_loaded()
	request("lunatik.runner.spawn(%q)", script)
end

function runners.stop(parsed, ...)
	unmodified("stop", parsed)
	if select("#", ...) == 0 then misuse("stop takes a script") end
	ensure_loaded()
	local stopped = true
	for _, script in ipairs({...}) do
		if request("return lunatik.runner.stop(%q)", script) == "false" then
			report(script .. " is not running")
			stopped = false
		end
	end
	os.exit(stopped)
end

function runners.list(parsed, script)
	unmodified("list", parsed)
	if script ~= nil then misuse("list takes no script") end
	ensure_loaded()
	local scripts = request("return lunatik.runner.list()")
	if scripts ~= "" then print((scripts:gsub(", ", "\n"))) end
end

local function main()
	local parsed = {}
	local i = parse(1, general, parsed)
	local verb = arg[i]
	if verb ~= nil and (parsed.chunk ~= nil or parsed.interactive) then
		misuse((parsed.chunk and "-e" or "-i") .. " takes no command")
	end
	if parsed.chunk ~= nil then
		eval(parsed.chunk)
		if parsed.interactive then start_repl() end
		return
	end
	if verb == nil then
		return start_repl()
	end
	local command = commands[verb]
	if command ~= nil then
		os.exit(command(table.unpack(arg, i + 1)))
	end
	local handler = runners[verb]
	if handler == nil then
		misuse("unknown command " .. verb)
	end
	i = parse(i + 1, modifying, parsed)
	handler(parsed, table.unpack(arg, i))
end

local ok, err = pcall(main)
if not ok then
	fail(err)
end

