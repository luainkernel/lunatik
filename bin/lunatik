local config = require("lunatik.config")

local device    = "/dev/lunatik"
local copyright = "Copyright (C) 2023-2026 Ring Zero Desenvolvimento de Software LTDA."
local modules   = config.modules

local function quote(word)
	return "'" .. word:gsub("'", "'\\''") .. "'"
end

local function exists(path)
	return os.execute("[ -e " .. quote(path) .. " ]")
end

local function probe()
	return exists(device)
end

local function open(path, mode)
	local file, err = io.open(path, mode)
	if file == nil then error(err, 0) end -- the message is the user's, with no position in this script
	return file
end

local function dostring(chunk)
	if chunk == "" then return true, "" end -- an empty write never reaches the driver
	local session <close> = open(device, "r+")
	session:setvbuf("no") -- the driver runs each write as a chunk
	assert(session:write(chunk))
	session:flush()
	local reply = assert(session:read("a"))
	local status, result = reply:match("^(%a+)\t(.*)$")
	if status == nil then error("couldn't read " .. device .. ": loaded from another build", 0) end
	return status == "true", result
end

local function sh(command, module, loaded)
	local op = loaded and "&&" or "||"
	return os.execute(string.format("MODULE=%s;grep -wq $MODULE /proc/modules %s%s", module, op, command))
end

local function load_modules()
	for _, m in ipairs(modules) do
		sh("modprobe $MODULE", m)
	end
	if not probe() then
		error("couldn't create " .. device, 0)
	end
	local ok, result = dostring[[
		lunatik = require("lunatik")
		lunatik.runner = require("lunatik.runner")
		lunatik.runner.startup()
	]]
	if not ok then error(result, 0) end
end

local function readall(handle)
	local h <close> = handle
	return h and h:read("a") or ""
end

local function loaded_modules()
	return readall(io.popen("ls /sys/module/lunatik/holders 2>/dev/null && echo lunatik")):gmatch("%S+")
end

local function refcount(module)
	return tonumber(readall(io.open("/sys/module/" .. module .. "/refcnt")))
end

local function stale_modules()
	local stale = {}
	for m in loaded_modules() do
		local loaded = readall(io.open("/sys/module/" .. m .. "/srcversion")):match("%S*")
		local info = readall(io.popen("modinfo " .. m .. " 2>/dev/null")) -- OpenWrt's modinfo takes no option
		local installed = info:match("\nsrcversion:%s*(%S+)") or ""
		if loaded ~= installed then
			table.insert(stale, m)
		end
	end
	return stale
end

local function unload_unused()
	local removed = 0
	for m in loaded_modules() do
		if refcount(m) == 0 and sh("rmmod $MODULE", m, true) then
			removed = removed + 1
		end
	end
	return removed
end

local pins_path = "/sys/fs/bpf/lunatik/"

-- a directory under a root is another script's root, as tests/xdp/pass's is under tests
local function pins(root)
	local found = {}
	for name in readall(io.popen("ls -p " .. quote(root) .. " 2>/dev/null")):gmatch("[^\n]+") do
		if name:sub(-1) ~= "/" then table.insert(found, root .. "/" .. name) end
	end
	return found
end

-- removing a link's pin alone leaves its detach to a work item, after the command has returned
local function detach(root)
	for _, pin in ipairs(pins(root)) do
		if pin:match("%-link$") then
			local loader = require("luaebpf.loader")
			local detached, err = loader.detach(pin)
			if not detached then return err end
		end
	end
end

-- a compiled program outlives its runtime, so a shutdown alone leaves it on the device
local function unload_programs()
	local failure
	for root in readall(io.popen("find " .. quote(pins_path) .. " -type d 2>/dev/null")):gmatch("[^\n]+") do
		failure = detach(root) or failure
	end
	os.execute("rm -rf " .. quote(pins_path) .. " 2>/dev/null")
	if failure then error(failure, 0) end
end

local function unload_modules()
	unload_programs()
	if probe() then
		local ok, result = dostring("lunatik.runner.shutdown()")
		if not ok then error(result, 0) end
	end
	repeat
		local removed = unload_unused()
	until removed == 0
end

local function reload_modules()
	unload_modules()
	load_modules()
	local stale = stale_modules()
	if #stale > 0 then
		error("couldn't replace " .. table.concat(stale, ", ") .. ": loaded from another build", 0)
	end
end

local function status_modules()
	for _, m in ipairs(modules) do
		sh("echo $MODULE is loaded || echo $MODULE is not loaded", m, true)
	end
	for _, m in ipairs(stale_modules()) do
		print(m .. " is not the installed build")
	end
end

local function ensure_loaded()
	if not probe() then load_modules() end
	local ok, result = dostring[[
		lunatik = lunatik or require("lunatik")
		lunatik.runner = lunatik.runner or require("lunatik.runner")
		lunatik.runner.startup()
	]]
	if not ok then error(result, 0) end
end

local tests_path = "/usr/local/share/lunatik/tests"
local scripts_path = "/lib/modules/lua/"

local function test_modules(suite)
	local target = suite and (tests_path .. "/" .. suite .. "/run.sh")
	                      or (tests_path .. "/run.sh")
	if not os.execute("[ -f " .. target .. " ]") then
		error("tests not installed; run: sudo make tests_install", 0)
	end
	reload_modules()
	ensure_loaded()
	local ok, _, code = os.execute("bash " .. target)
	unload_modules()
	return ok or code
end

local function compile_scripts(...)
	local args = {}
	for _, word in ipairs({...}) do
		table.insert(args, quote(word))
	end
	local ok, _, code = os.execute("lunatic " .. table.concat(args, " "))
	os.exit(ok or code)
end

local commands = {
	load   = load_modules,
	unload = unload_modules,
	reload = reload_modules,
	status = status_modules,
	test   = test_modules,
	compile = compile_scripts,
}

local function readline_reader()
	local rl = require("readline")
	rl.set_readline_name("lunatik")
	local function read_line(prompt)
		local line = rl.readline(prompt)
		if line and line ~= "" then rl.add_history(line) end
		return line
	end
	return read_line
end

local function fallback_reader(prompt)
	io.write(prompt)
	io.flush()
	return io.read("l")
end

local function piped_reader()
	return io.read("l")
end

local function isterminal()
	return os.execute("[ -t 0 ]")
end

local usage = [=[
usage: lunatik [-h | -V]
       lunatik [-i] [-e <chunk>]
       lunatik load | unload | reload | status
       lunatik run [-c process | softirq | hardirq] [-p] [--dev=<ifname>] <script>
       lunatik spawn <script>
       lunatik stop <script>...
       lunatik list
       lunatik test [<suite>]
       lunatik compile [<lunatic argument>...]
       lunatik bpf [--btf=<file>] [-o <object>] <program>]=]

local function report(message)
	io.stderr:write("lunatik: ", message, "\n")
end

local function fail(message)
	report(message)
	os.exit(false)
end

local function misuse(message)
	io.stderr:write("lunatik: ", message, "\n", usage, "\n")
	os.exit(2)
end

local function try_as_expr(chunk)
	return load("return " .. chunk .. ";") ~= nil
end

local function is_incomplete(chunk)
	local _, err = load(chunk)
	return err ~= nil and err:sub(-5) == "<eof>"
end

local function repl(read_line)
	local line = read_line("> ")
	while line ~= nil do
		local chunk = line
		local expr = try_as_expr(chunk) -- a name or a field also reads as an unfinished assignment
		while not expr and is_incomplete(chunk) do
			local more = read_line(">> ")
			if more == nil then break end
			chunk = chunk .. "\n" .. more
			expr = try_as_expr(chunk)
		end
		local ok, res = dostring(expr and ("return " .. chunk) or chunk)
		if not ok then
			io.stderr:write(res, "\n")
		elseif res ~= "" then
			print(res)
		end
		line = read_line("> ")
	end
end

local function version()
	local _, result = dostring("return _LUNATIK_VERSION")
	return result
end

local function start_repl()
	ensure_loaded()
	if not isterminal() then
		return repl(piped_reader)
	end
	print(version() .. "  " .. copyright)
	local ok, read_line = pcall(readline_reader)
	if not ok then read_line = fallback_reader end
	repl(read_line)
end

local function request(chunk, ...)
	local ok, result = dostring(string.format(chunk, ...))
	if not ok then fail(result) end
	return result
end

local function eval(chunk)
	ensure_loaded()
	local result = request("%s", chunk)
	if result ~= "" then print(result) end
end

local contexts = {process = true, softirq = true, hardirq = true}

local options = {}
local spellings = {}
local valued = {}

-- an option with no handler of its own stores its value, or true when it takes none, under its name
local function option(name, short, hasvalue, handler)
	spellings["--" .. name] = name
	if short ~= nil then spellings["-" .. short] = name end
	valued[name] = hasvalue
	options[name] = handler or function(parsed, value) parsed[name] = value or true end
	return name
end

local function accepting(...)
	local accepted = {}
	for _, name in ipairs({...}) do
		accepted[name] = true
	end
	return accepted
end

local function print_usage()
	print(usage)
	os.exit()
end

local function print_version()
	if not probe() then fail("not loaded") end
	print(version())
	os.exit()
end

local function set_context(parsed, word)
	if not contexts[word] then
		misuse(word .. " is not a context: process, softirq or hardirq")
	end
	parsed.context = word
end

local general = accepting(
	option("help", "h", false, print_usage),
	option("version", "V", false, print_version),
	option("interactive", "i"),
	option("eval", "e", true))
local modifying = accepting("--",
	option("context", "c", true, set_context),
	option("percpu", "p"))
-- run takes what modifying does, and the device its compiled program attaches to
local deploying = setmetatable(accepting(option("dev", nil, true)), {__index = modifying})
local compiling = accepting("--", option("output", "o", true), option("btf", nil, true))
local takes = {run = deploying, bpf = compiling}

local function parse(i, accepted, parsed)
	while arg[i] ~= nil and arg[i]:sub(1, 1) == "-" do
		if arg[i] == "--" and accepted["--"] then
			return i + 1
		end
		local spelling, value = arg[i]:match("^(%-%-[^=]+)=(.*)$")
		spelling = spelling or arg[i]
		local name = spellings[spelling]
		if name == nil or not accepted[name] then
			misuse("unknown option " .. spelling)
		elseif valued[name] and value == nil then
			i = i + 1
			value = arg[i] or misuse(spelling .. " takes a value")
		elseif not valued[name] and value ~= nil then
			misuse(spelling .. " takes no value")
		end
		options[name](parsed, value)
		i = i + 1
	end
	return i
end

local function unmodified(verb, parsed, ...)
	if parsed.context or parsed.percpu or select("#", ...) > 0 then
		misuse(verb .. " takes no context and no percpu")
	end
end

local function start(script, parsed)
	local chunk = "lunatik.runner.run(%q, {context = %q, percpu = %q})"
	return dostring(string.format(chunk, script, parsed.context, parsed.percpu))
end

local function halt(script)
	return request("return lunatik.runner.stop(%q)", script) == "true"
end

local function running()
	return request("return table.concat(lunatik.runner.list(), '\\n')")
end

local function isrunning(script)
	for name in running():gmatch("[^\n]+") do
		if name == script then return true end
	end
	return false
end

-- the runner registers a script with ".lua" dropped, and every path here comes from that name
local function trim(script)
	return (script:gsub("%.lua$", ""))
end

-- bpffs refuses a dot, so no name climbs out of the pins path, and an empty component respells another run's root
local function rootof(script)
	return script:match("^[^.]+$") and not ("/" .. script .. "/"):find("//", 1, true) and pins_path .. script
end

local function unpin(root)
	local found = pins(root)
	for _, pin in ipairs(found) do
		os.remove(pin)
	end
	-- a nested script's root has parents of its own, and one that holds another script's root is not empty
	while #root > #pins_path and os.remove(root) do
		root = root:match("^(.*)/")
	end
	return #found > 0
end

local function undo(root, script, message)
	detach(root)
	if script then halt(script) end
	unpin(root)
	fail(message)
end

-- a step that failed takes back what the steps before it pinned, started and attached
local function step(root, script, done, message)
	if not done then undo(root, script, message) end
end

-- a compiled program's run takes a device, and a context or percpu only where a kernel script takes them
local function deployable(parsed, script)
	local scripted = exists(scripts_path .. script .. ".lua")
	if parsed.dev == nil then
		misuse(script .. " needs --dev")
	elseif not scripted and (parsed.context or parsed.percpu) then
		misuse(script .. " has no kernel script to take a context or percpu")
	end
	local root = rootof(script) or fail("couldn't pin " .. script .. ": a root takes no dot and no empty component")
	return root, scripted
end

-- a load adopts the maps a previous run left pinned, and its links still hold the device
local function clear(root)
	local stale = detach(root)
	unpin(root)
	if stale then fail(stale) end
	os.execute("mkdir -p " .. quote(root))
end

-- the maps are pinned before the runtime starts, since its script opens them, and the programs attach after it
local function deploy(parsed, script, object)
	local root, scripted = deployable(parsed, script)
	local program, err = require("luaebpf.loader").open(object)
	if program == nil then fail(err) end
	ensure_loaded()
	-- the runtime would refuse the run anyway, and the root below is the live run's
	if isrunning(script) then fail(script .. " is already running") end
	clear(root)
	step(root, nil, program:load(root))
	if scripted then step(root, nil, start(script, parsed)) end
	step(root, scripted and script, program:attach(root, parsed.dev))
end

-- the links detach first and the maps go last, the reverse of deploy
local function teardown(script)
	local root = rootof(trim(script))
	local failure = root and detach(root)
	local halted = halt(script)
	local deployed = root and unpin(root)
	if failure then
		return failure
	elseif not (halted or deployed) then
		return script .. " is not running"
	end
end

local runners = {}

function runners.run(parsed, script, ...)
	if script == nil then misuse("run takes a script") end
	if select("#", ...) > 0 then misuse("run takes nothing after the script") end
	local name = trim(script)
	local object = scripts_path .. name .. ".bpf.o"
	if exists(object) then
		return deploy(parsed, name, object)
	end
	if parsed.dev then misuse(script .. " has no compiled program for --dev") end
	ensure_loaded()
	local started, err = start(script, parsed)
	if not started then fail(err) end
end

function runners.spawn(parsed, script, ...)
	if script == nil then misuse("spawn takes a script") end
	unmodified("spawn", parsed, ...)
	ensure_loaded()
	request("lunatik.runner.spawn(%q)", script)
end

function runners.stop(parsed, ...)
	unmodified("stop", parsed)
	if select("#", ...) == 0 then misuse("stop takes a script") end
	ensure_loaded()
	local stopped = true
	for _, script in ipairs({...}) do
		local failure = teardown(script)
		if failure then
			report(failure)
			stopped = false
		end
	end
	os.exit(stopped)
end

function runners.list(parsed, script)
	unmodified("list", parsed)
	if script ~= nil then misuse("list takes no script") end
	ensure_loaded()
	local scripts = running()
	if scripts ~= "" then print(scripts) end
end

function runners.bpf(parsed, program, ...)
	if program == nil then misuse("bpf takes a program file") end
	if select("#", ...) > 0 then misuse("bpf takes nothing after the program file") end
	local luaebpf = require("luaebpf")
	local object, calls = luaebpf.compile(program, parsed.btf)
	local path = parsed.output or program:gsub("%.lua$", "") .. ".o"
	local file = open(path, "wb")
	assert(file:write(object))
	assert(file:close())
	for _, call in ipairs(calls) do
		print(call)
	end
end

local function main()
	local parsed = {}
	local i = parse(1, general, parsed)
	local verb = arg[i]
	if verb ~= nil and (parsed.eval ~= nil or parsed.interactive) then
		misuse((parsed.eval and "-e" or "-i") .. " takes no command")
	end
	if parsed.eval ~= nil then
		eval(parsed.eval)
		if parsed.interactive then start_repl() end
		return
	end
	if verb == nil then
		return start_repl()
	end
	local command = commands[verb]
	if command ~= nil then
		local signature = debug.getinfo(command, "u")
		local extra = arg[i + 1 + signature.nparams]
		if extra ~= nil and not signature.isvararg then
			misuse("extra operand " .. extra)
		end
		os.exit(command(table.unpack(arg, i + 1)))
	end
	local handler = runners[verb]
	if handler == nil then
		misuse("unknown command " .. verb)
	end
	i = parse(i + 1, takes[verb] or modifying, parsed)
	handler(parsed, table.unpack(arg, i))
end

local ok, err = pcall(main)
if not ok then
	fail(err)
end

