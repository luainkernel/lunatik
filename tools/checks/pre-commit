#
# Pre-commit hook: the gate of the harness mounted at harness/, then kernel code calling a string
# function the kernel has removed.
# Install with: ln -s ../../tools/checks/pre-commit .git/hooks/pre-commit

# the mount beside this script: the hook in .git/hooks runs it for every worktree, one older than the mount too
bash "$(dirname "$(readlink -f "$0")")/../../harness/tools/checks/pre-commit" || exit 1

# strncpy and strlcpy are gone from <linux/string.h>, so a call left in the tree
# builds on the kernels that still declare them and stops the build on the ones
# that do not.
removed=""
for f in $(git diff --cached --name-only --diff-filter=ACM); do
	case "$f" in
		*.c|*.h)
			if git show ":$f" | grep -qE '\b(strncpy|strlcpy)\b'; then
				removed="$removed $f"
			fi
			;;
	esac
done

if [ -n "$removed" ]; then
	echo "ERROR: Files calling a string function the kernel removed:"
	for f in $removed; do
		echo "  $f"
	done
	echo "memcpy copies an exact length, strscpy terminates, strscpy_pad also zeroes the rest."
	exit 1
fi

