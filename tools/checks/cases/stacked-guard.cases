# run in the directory stacked-guard.fixture.sh builds
# env: PATH=stub:/usr/local/bin:/usr/bin:/bin
block	gh api repos/luainkernel/lunatik/pulls -f head=a -f base=b -F body=@b.md
block	gh api repos/luainkernel/lunatik/pulls -fhead=a -fbase=b -F body=@b.md
block	gh api -f head=a -f base=b -F body=@b.md repos/luainkernel/lunatik/pulls
block	gh pr create --base b --head a --body-file b.md
block	gh pr new -B b --head a --body-file b.md
block	gh -R luainkernel/lunatik pr create --base b --head a --body-file b.md
block	gh -Rluainkernel/lunatik pr create --base b --head a --body-file b.md
block	gh pr -Rluainkernel/lunatik create --base b --head a --body-file b.md
pass	gh api repos/luainkernel/lunatik/pulls -f head=a -f base=b -F draft=true -F body=@b.md
pass	gh pr create --base b --head a --draft --body-file b.md
pass	gh --repo luainkernel/lunatik pr create --base b --head a --draft --body-file b.md
pass	gh api repos/luainkernel/lunatik/pulls -f head=a -f base=master -F body=@b.md
pass	gh api repos/luainkernel/lunatik/pulls/7 --jq '.base.ref'
block	gh api repos/luainkernel/lunatik/pulls --input stacked.json
block	gh api --input=stacked.json repos/luainkernel/lunatik/pulls
block	gh api repos/luainkernel/lunatik/pulls --input stacked.json -F draft=true
pass	gh api repos/luainkernel/lunatik/pulls --input draft.json
pass	gh api repos/luainkernel/lunatik/pulls --input master.json
block	gh api repos/luainkernel/lunatik/pulls --input sub/s.json
block	cd sub && gh api repos/luainkernel/lunatik/pulls --input s.json
block	cd sub && gh api --input=s.json repos/luainkernel/lunatik/pulls
block	cd sub && gh api repos/luainkernel/lunatik/pulls --input master.json
block	gh api -X PATCH repos/luainkernel/lunatik/pulls/9 --input move.json
block	gh api -X PATCH repos/luainkernel/lunatik/pulls/9 -f base=bump
block	gh pr edit 9 --base bump
block	gh -R luainkernel/lunatik pr edit 9 --base bump
block	gh --repo=luainkernel/lunatik pr edit 9 --base bump
block	gh pr -Rluainkernel/lunatik edit 9 --base bump
pass	gh -Rluainkernel/lunatik pr edit 8 --base bump
pass	gh -R=luainkernel/lunatik pr edit 8 --base bump
block	gh -R luainkernel/lunatik pr edit 8 --base bump -R luainkernel/lua
pass	gh api -X PATCH repos/luainkernel/lunatik/pulls/8 --input move.json
pass	gh api repos/luainkernel/lunatik/pulls/8 -X PATCH -f base=bump -f body="after repos/luainkernel/lua/pulls/9"
block	gh api repos/luainkernel/lunatik/pulls/9 -X PATCH -f base=bump -f body="after repos/luainkernel/lunatik/pulls/8"
pass	gh api -X PATCH repos/luainkernel/lunatik/pulls/9 -f base=master
pass	gh api -X PATCH repos/luainkernel/lunatik/pulls/9 -f title=fallback
# a gh on keyed/ answers as stub/'s only with the token in key, which the command reads into GH_TOKEN
# env: PATH=keyed:/usr/local/bin:/usr/bin:/bin
# env: GH_TOKEN=
pass	tok=$(cat key); GH_TOKEN=$tok gh -R luainkernel/lunatik pr edit 8 --base bump
block	GH_TOKEN=$tok gh -R luainkernel/lunatik pr edit 8 --base bump
