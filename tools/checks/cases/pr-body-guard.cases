# run in the repository pr-body-guard.fixture.sh builds
block	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=master -F draft=true -F body=@silent.md
block	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -F body=@silent.md
pass	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=master -F body=@named.md
pass	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=master -F body=@ticked.md
block	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=master -F body=@bare.md
pass	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=fifo -F draft=true -F body=@silent.md
pass	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=local-base -F draft=true -F body=@silent.md
block	gh api repos/luainkernel/lunatik/pulls -f head=fifo-test -f base=gone -F draft=true -F body=@silent.md
block	gh api repos/luainkernel/lunatik/pulls --input master.json
pass	gh api repos/luainkernel/lunatik/pulls --input fifo.json
block	gh pr create --head fifo-test --base master --body-file silent.md
pass	gh pr create --head fifo-test --base master --body-file named.md
