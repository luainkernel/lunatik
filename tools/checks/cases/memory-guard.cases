# run in the directory memory-guard.fixture.sh builds, whose user directory holds a project's memories
# env: HOME=user
block	cat >> ~/.claude/projects/p/memory/feedback_bare.md <<'EOF'\n- also after a reboot\nEOF
block	echo '- also after a reboot' >> "$HOME/.claude/projects/p/memory/feedback_bare.md"
block	cd /srv && echo more >> ${HOME}/.claude/projects/p/memory/feedback_bare.md 2> /dev/null
block	sed -i 's/twice/three times/' ~/.claude/projects/p/memory/feedback_bare.md
block	sudo sed -Ei -e 's/twice/three times/' user/.claude/projects/p/memory/feedback_bare.md
block	echo more | tee -a ~/.claude/projects/p/memory/feedback_bare.md > /dev/null
block	bash -c "echo more >> ~/.claude/projects/p/memory/feedback_bare.md"
block	cat > ~/.claude/projects/p/memory/feedback_new.md <<'EOF'\n---\nname: feedback-new\nmetadata:\n  type: feedback\n---\n\nRead the journal first.\nEOF
block	cd ~/.claude/projects/p/memory && cat >> feedback_bare.md <<'EOF'\n- also after a reboot\nEOF
block	cd "$HOME/.claude/projects/p/memory/" && cat > feedback_new.md <<'EOF'\n---\nname: feedback-new\nmetadata:\n  type: feedback\n---\n\nRead the journal first.\nEOF
block	M=~/.claude/projects/p/memory; cat >> $M/feedback_bare.md <<'EOF'\n- also after a reboot\nEOF
block	M="$HOME/.claude/projects/p/memory"; cd /srv && echo more | tee -a "${M}/feedback_bare.md"
block	F=user/.claude/projects/p/memory/feedback_bare.md; sed -i 's/twice/three times/' $F; sed -n 1,5p $F
block	cat >> ~/.claude/projects/p/memory/feedback_bare.md <<'EOF'\n- also after a reboot (#2155)\nEOF
block	echo more >> ~/.claude/projects/p/memory/feedback_placed.md
block	M=~/.claude/projects/p/memory; cat >> $M/feedback_placed.md <<'EOF'\n\n**2026-11-15:** the reader's `body-read.sh --pass` is refused by the auto mode classifier, so with #2541 the guard blocked every body post. Lesson: a harness mechanism that depends on a command an agent runs is exercised in auto mode before it merges.\nEOF
block	cat >> ~/.claude/projects/p/memory/feedback_bare.md <<'EOF'\n- answer in the maintainer's language, as CLAUDE.local.md says\nEOF
block	sed -i 's/type: feedback/type: user/' ~/.claude/projects/p/memory/feedback_bare.md
pass	cat >> ~/.claude/projects/p/memory/feedback_bare.md <<'EOF'\n- also after a reboot, in AGENTS.md\nEOF
pass	cat > ~/.claude/projects/p/memory/feedback_new.md <<'EOF'\n---\nname: feedback-new\nmetadata:\n  type: feedback\n---\n\nRead the journal first: tools/journal.sh.\nEOF
pass	echo more >> ~/.claude/projects/p/memory/project_batch.md
pass	echo '- [New](feedback_new.md) - read the journal first' >> ~/.claude/projects/p/memory/MEMORY.md
pass	cd ~/.claude/projects/p/memory && cat >> feedback_bare.md <<'EOF'\n- also after a reboot, in AGENTS.md\nEOF
pass	echo '- also after a reboot, in AGENTS.md' | tee -a ~/.claude/projects/p/memory/feedback_bare.md > /dev/null
pass	sed -i 's/twice/twice, as AGENTS.md says/' ~/.claude/projects/p/memory/feedback_bare.md
pass	M=~/.claude/projects/p/memory; echo '- also after a reboot: tools/journal.sh' >> $M/feedback_bare.md
pass	cd ~/.claude/projects/p/memory && cat >> project_batch.md <<'EOF'\nA fourth run.\nEOF
pass	cd ~/.claude/projects/p/memory && cat feedback_bare.md > /srv/feedback_bare.md
pass	M=/srv/notes; echo more >> $M/feedback_bare.md
pass	F=~/.claude/projects/p/memory/feedback_bare.md; grep -c twice $F
pass	cat ~/.claude/projects/p/memory/feedback_bare.md
pass	sed 's/twice/three times/' ~/.claude/projects/p/memory/feedback_bare.md
pass	grep -c twice ~/.claude/projects/p/memory/feedback_bare.md > /dev/null
pass	echo more >> scratch/memory/feedback_bare.md
pass	cat > scratch/memory/feedback_new.md <<'EOF'\n---\nname: feedback-new\nmetadata:\n  type: feedback\n---\n\nRead the journal first.\nEOF
